{
  "manifest_version": 3,
  "name": "Marklet — Async Design Reviews for Web Prototypes",
  "short_name": "Marklet",
  "version": "0.0.0",
  "description": "Figma-style feedback on any web prototype. Send your team a link for async reviews, merge comments, and export for AI.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Marklet — Async Design Reviews for Web Prototypes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Open Marklet on the active tab"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
